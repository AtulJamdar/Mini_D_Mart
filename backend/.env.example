# Server & Database Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/mini_dmart
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_mini_dmart_change_in_production
JWT_EXPIRES_IN=7d

# Phone OTP & Twilio SMS Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Razorpay Payment Gateway Integration
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# SMTP Email Service Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=no-reply@mini-dmart.com
SMTP_FROM_NAME=Mini D-Mart
ADMIN_ALERT_EMAIL=inventory@mini-dmart.com

# Inventory Thresholds
LOW_STOCK_THRESHOLD=5

# Admin Seed Variables (optional overrides for npm run seed:admin)
ADMIN_SEED_EMAIL=admin@minidmart.com
ADMIN_SEED_PASSWORD=Admin@123456
ADMIN_SEED_FIRST_NAME=System
ADMIN_SEED_LAST_NAME=Admin
